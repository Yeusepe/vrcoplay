+bool getRouterWanIP4(IN_ADDR nextHop, IN_ADDR* wan)
+{
+    HANDLE icmp = IcmpCreateFile();
+    if (icmp == INVALID_HANDLE_VALUE) return false;
+    unsigned char route[40] = { 7, 39, 4 };
+    IP_OPTION_INFORMATION options = { 64, 0, 0, sizeof(route), route };
+    unsigned char buffer[512] = {};
+    DWORD count = IcmpSendEcho(icmp, nextHop.s_addr, nullptr, 0, &options, buffer, sizeof(buffer), 2000);
+    IcmpCloseHandle(icmp);
+    auto reply = (ICMP_ECHO_REPLY*)buffer;
+    if (!count || reply->Status != IP_SUCCESS) return false;
+    auto data = reply->Options.OptionsData;
+    int size = reply->Options.OptionsSize;
+    for (int offset = 0; data && offset < size && data[offset];) {
+        if (data[offset] == 1) { ++offset; continue; }
+        if (offset + 2 > size || data[offset + 1] < 2 || offset + data[offset + 1] > size) break;
+        if (data[offset] == 7 && data[offset + 1] >= 11) {
+            int end = min(data[offset + 1], data[offset + 2] - 1);
+            for (int i = 7; i + 4 <= end; i += 4) {
+                IN_ADDR current, previous;
+                memcpy(&current, data + offset + i, 4);
+                memcpy(&previous, data + offset + i - 4, 4);
+                if (current.s_addr == nextHop.s_addr && previous.s_addr && previous.s_addr != nextHop.s_addr) {
+                    *wan = previous;
+                    return true;
+                }
+            }
+        }
+        offset += data[offset + 1];
+    }
+    return false;
+}
