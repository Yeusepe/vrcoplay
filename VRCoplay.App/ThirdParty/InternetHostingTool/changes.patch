diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,27 @@
+cmake_minimum_required(VERSION 3.28)
+project(iht LANGUAGES C CXX)
+set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+include(FetchContent)
+set(UPNPC_BUILD_SHARED OFF CACHE BOOL "" FORCE)
+set(UPNPC_BUILD_TESTS OFF CACHE BOOL "" FORCE)
+set(UPNPC_BUILD_SAMPLE OFF CACHE BOOL "" FORCE)
+set(UPNPC_NO_INSTALL ON CACHE BOOL "" FORCE)
+FetchContent_Declare(miniupnp GIT_REPOSITORY https://github.com/miniupnp/miniupnp.git
+    GIT_TAG 2cb87d04034587bdb0f51549b3936e0d9e143bcb SOURCE_SUBDIR miniupnpc EXCLUDE_FROM_ALL)
+FetchContent_Declare(natpmp GIT_REPOSITORY https://github.com/miniupnp/libnatpmp.git
+    GIT_TAG 134fc89e2781e154e40042641f4d8bcbe42579f1 EXCLUDE_FROM_ALL)
+FetchContent_MakeAvailable(miniupnp natpmp)
+configure_file(LICENSE licenses/iht.txt COPYONLY)
+configure_file(${miniupnp_SOURCE_DIR}/LICENSE licenses/miniupnpc.txt COPYONLY)
+configure_file(${natpmp_SOURCE_DIR}/LICENSE licenses/libnatpmp.txt COPYONLY)
+target_compile_definitions(libminiupnpc-static PRIVATE MINIUPNPC_SET_SOCKET_TIMEOUT)
+file(COPY ${miniupnp_SOURCE_DIR}/miniupnpc/include/ DESTINATION ${CMAKE_BINARY_DIR}/include/miniupnpc)
+add_library(iht SHARED miss/miss.cpp miss/pcp.cpp miss/tracer.cpp)
+foreach(target iht)
+    if(TARGET ${target})
+        target_compile_features(${target} PRIVATE cxx_std_17)
+        target_compile_definitions(${target} PRIVATE IHT_LIBRARY)
+        target_include_directories(${target} PRIVATE ${CMAKE_BINARY_DIR}/include)
+        target_link_libraries(${target} PRIVATE miniupnpc::miniupnpc natpmp ws2_32 iphlpapi shlwapi advapi32)
+    endif()
+endforeach()
