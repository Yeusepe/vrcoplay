+extern "C" __declspec(dllexport) int IhtMap(const IhtRequest* request, char* address)
+{
+    if (address) *address = 0;
+    if (!request || !address || !request->ports || request->count < 1 || request->count > 16
+        || !request->owner || !*request->owner || strnlen_s(request->owner, 65) > 64
+        || request->lifetime < 0 || request->lifetime > 86400) return 0;
+    for (int i = 0; i < request->count; ++i)
+        if ((request->ports[i].protocol != IPPROTO_TCP && request->ports[i].protocol != IPPROTO_UDP)
+            || request->ports[i].port < 1 || request->ports[i].port > 65535
+            || request->ports[i].internalPort < 0 || request->ports[i].internalPort > 65535) return 0;
+    std::lock_guard<std::mutex> lock(s_LibraryMutex);
+    WSADATA wsa;
+    if (WSAStartup(MAKEWORD(2, 2), &wsa)) return 0;
+    CheckDiscoveryNetwork();
+    s_Request = request;
+    s_MappingError = 0;
+    s_Ports = request->ports;
+    s_PortCount = request->count;
+    bool result = UpdatePortMappings(request->lifetime != 0, address);
+    int error = s_MappingError;
+    if (!result && request->lifetime) {
+        UpdatePortMappings(false);
+        // A changed or failed upstream path must be discovered again on retry.
+        s_HopCount = -1;
+    }
+    s_Request = nullptr;
+    s_Ports = k_Ports;
+    s_PortCount = ARRAYSIZE(k_Ports);
+    WSACleanup();
+    if (!result) *address = 0;
+    return result ? 1 : -error;
+}
