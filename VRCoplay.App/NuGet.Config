<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="Win2D-local" value="ThirdParty/Win2D/artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="CommunityToolkit-Labs" value="https://pkgs.dev.azure.com/dotnet/CommunityToolkit/_packaging/CommunityToolkit-Labs/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="Win2D-local"><package pattern="VRCoplay.Win2D" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="CommunityToolkit-Labs"><package pattern="CommunityToolkit.Labs.*" /></packageSource>
  </packageSourceMapping>
</configuration>
