<Application x:Class="VRCoplay.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:VRCoplay" xmlns:text="using:Windows.UI.Text">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Satoshi-Variable.ttf#Satoshi Variable</FontFamily>
      <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>

      <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
      <CornerRadius x:Key="ComboBoxHiglightBorderCornerRadius">16</CornerRadius>

      <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="FlyoutPresenterBackground" />
      <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="FlyoutBorderThemeBrush" />

      <GridLength x:Key="TeachingTipTailMargin">24</GridLength>
      <x:Double x:Key="TextControlThemeMinHeight">44</x:Double>

      <Thickness x:Key="TextControlThemePadding">10,11,6,11</Thickness>
      <x:Double x:Key="ComboBoxMinHeight">44</x:Double>
      <text:FontWeight x:Key="ComboBoxHeaderThemeFontWeight">Medium</text:FontWeight>
      <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}"><Setter Property="MinHeight" Value="44" /></Style>
      <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}"><Setter Property="MinHeight" Value="44" /></Style>
      <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,11,0,11" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
      </Style>
      <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,11" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
      </Style>
      <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="QuietText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="SettingsGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="Surface" TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
