<ContentDialog x:Class="VRCoplay.SharingWelcomeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" PrimaryButtonText="Continue" DefaultButton="Primary" Style="{StaticResource DefaultContentDialogStyle}" FontFamily="{StaticResource ContentControlThemeFontFamily}" AutomationProperties.Name="Sharing and privacy" CornerRadius="24" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
  <ContentDialog.Resources>
    <ResourceDictionary>
      <x:Double x:Key="ContentDialogMaxWidth">420</x:Double>
      <x:Double x:Key="ContentDialogMaxHeight">600</x:Double>
      <Thickness x:Key="ContentDialogTitleMargin">0,8,0,16</Thickness>
      <Thickness x:Key="ContentDialogPadding">24,24,24,12</Thickness>
      <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
      <x:Double x:Key="ContentDialogButtonSpacing">0</x:Double>
      <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="SolidBackgroundFillColorBaseBrush" />
    </ResourceDictionary>
  </ContentDialog.Resources>
  <ContentDialog.Title>
    <TextBlock Text="Sharing and privacy" Style="{StaticResource PageTitle}" TextAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
  </ContentDialog.Title>
  <ScrollViewer x:Name="WelcomeScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="WelcomeBody" Spacing="8">
      <TextBlock Text="Video goes directly to viewers, never through VRCoplay’s servers. Viewers may see your IP address. Share in trusted places or use a VPN." Style="{StaticResource QuietText}" FontSize="16" TextAlignment="Center" />
      <HyperlinkButton x:Name="SharingDetailsButton" Click="SharingDetails_Click" HorizontalAlignment="Center" MinHeight="44" Padding="8" CornerRadius="{StaticResource ControlCornerRadius}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="How sharing works">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="How sharing works" />
          <FontIcon Glyph="" FontSize="10" AutomationProperties.AccessibilityView="Raw" />
        </StackPanel>
        <FlyoutBase.AttachedFlyout>
          <Flyout Placement="Bottom">
            <Flyout.FlyoutPresenterStyle>
              <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                <Setter Property="Padding" Value="20" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
              </Style>
            </Flyout.FlyoutPresenterStyle>
            <TextBlock MaxWidth="304" TextWrapping="Wrap" Text="Your stream link directs viewers to your computer. Video goes straight to them. VRCoplay’s servers never see or store it.&#xA;&#xA;Your IP address is your computer’s internet address. A VPN can hide it when your stream uses the VPN connection." />
          </Flyout>
        </FlyoutBase.AttachedFlyout>
      </HyperlinkButton>
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
