<ContentDialog x:Class="VRCoplay.ProfileCenterDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:VRCoplay" Style="{StaticResource DefaultContentDialogStyle}" FontFamily="{StaticResource ContentControlThemeFontFamily}" CornerRadius="24" Title="Profile center" CloseButtonText="Close" DefaultButton="None">
  <ContentDialog.Resources>
    <ResourceDictionary>
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Default"><x:Boolean x:Key="ProfileEdgeEffectsEnabled">True</x:Boolean></ResourceDictionary>
      <ResourceDictionary x:Key="Light"><x:Boolean x:Key="ProfileEdgeEffectsEnabled">True</x:Boolean></ResourceDictionary>
      <ResourceDictionary x:Key="HighContrast"><x:Boolean x:Key="ProfileEdgeEffectsEnabled">False</x:Boolean></ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="SolidBackgroundFillColorBaseBrush" />
    </ResourceDictionary>
  </ContentDialog.Resources>
  <ContentDialog.CloseButtonStyle>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="Width" Value="112" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
  </ContentDialog.CloseButtonStyle>
  <Grid x:Name="DialogBody" RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Software, profile or controller" QueryIcon="Find" VerticalContentAlignment="Center" AutomationProperties.Name="Search controller profiles">
      <AutoSuggestBox.TextBoxStyle>
        <Style TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
          <Setter Property="MinHeight" Value="44" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Padding" Value="12,0" />
          <Setter Property="CornerRadius" Value="12" />
        </Style>
      </AutoSuggestBox.TextBoxStyle>
    </AutoSuggestBox>
    <TextBlock x:Name="ResultCount" Grid.Row="1" Style="{StaticResource QuietText}" AutomationProperties.LiveSetting="Polite" />
    <Grid Grid.Row="2">
      <ListView x:Name="ProfileList" SelectionMode="None" IsItemClickEnabled="False" AutomationProperties.Name="Controller profiles" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:ProfileEntry">
            <Border Padding="16" Margin="0,0,12,0" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="{x:Bind Profile.Software}" Style="{StaticResource QuietText}" />
                  <TextBlock Text="{x:Bind Profile.Name}" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="{x:Bind Profile.Description}" Style="{StaticResource QuietText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button Content="{x:Bind ButtonText, Mode=OneWay}" Tag="{x:Bind}" IsEnabled="{x:Bind CanInstall, Mode=OneWay}" Click="Install_Click" AutomationProperties.Name="{x:Bind InstallLabel, Mode=OneWay}" MinWidth="112" />
                  <ProgressRing Width="20" Height="20" IsActive="{x:Bind IsInstalling, Mode=OneWay}" AutomationProperties.Name="Installing profile" />
                </StackPanel>
                <InfoBar IsOpen="{x:Bind HasFeedback, Mode=OneWay}" IsClosable="False" Severity="{x:Bind Severity, Mode=OneWay}" Title="{x:Bind FeedbackTitle, Mode=OneWay}" Message="{x:Bind FeedbackMessage, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <Grid x:Name="TopEdge" Height="32" Margin="0,0,12,0" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="{x:Bind EdgeOpacity(_scroller.VerticalOffset, 0, ProfileList.Visibility), Mode=OneWay, FallbackValue=0}" AutomationProperties.AccessibilityView="Raw">
        <Border><Border.Background><local:ScrollEdgeBlurBrush Reverse="True" BlurAmount="2" EndOffset="0.5" EffectsEnabled="{ThemeResource ProfileEdgeEffectsEnabled}" /></Border.Background></Border>
        <Border><Border.Background><local:ScrollEdgeBlurBrush Reverse="True" BlurAmount="5" StartOffset="0.22" EndOffset="0.75" EffectsEnabled="{ThemeResource ProfileEdgeEffectsEnabled}" /></Border.Background></Border>
        <Border><Border.Background><local:ScrollEdgeBlurBrush Reverse="True" BlurAmount="10" StartOffset="0.44" EffectsEnabled="{ThemeResource ProfileEdgeEffectsEnabled}" /></Border.Background></Border>
        <Border><Border.Background><local:ScrollEdgeBlurBrush Reverse="True" StartOffset="0.45" TintColor="{ThemeResource SolidBackgroundFillColorBase}" EffectsEnabled="{ThemeResource ProfileEdgeEffectsEnabled}" /></Border.Background></Border>
      </Grid>
      <Grid x:Name="BottomEdge" Height="32" Margin="0,0,12,0" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="{x:Bind EdgeOpacity(_scroller.ScrollableHeight, _scroller.VerticalOffset, ProfileList.Visibility), Mode=OneWay, FallbackValue=0}" AutomationProperties.AccessibilityView="Raw">
        <Border><Border.Background><local:ScrollEdgeBlurBrush BlurAmount="2" EndOffset="0.5" EffectsEnabled="{ThemeResource ProfileEdgeEffectsEnabled}" /></Border.Background></Border>
        <Border><Border.Background><local:ScrollEdgeBlurBrush BlurAmount="5" StartOffset="0.22" EndOffset="0.75" EffectsEnabled="{ThemeResource ProfileEdgeEffectsEnabled}" /></Border.Background></Border>
        <Border><Border.Background><local:ScrollEdgeBlurBrush BlurAmount="10" StartOffset="0.44" EffectsEnabled="{ThemeResource ProfileEdgeEffectsEnabled}" /></Border.Background></Border>
        <Border><Border.Background><local:ScrollEdgeBlurBrush StartOffset="0.45" TintColor="{ThemeResource SolidBackgroundFillColorBase}" EffectsEnabled="{ThemeResource ProfileEdgeEffectsEnabled}" /></Border.Background></Border>
      </Grid>
      <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="16">
        <TextBlock Text="No matching profiles" Style="{StaticResource SectionTitle}" TextAlignment="Center" />
        <TextBlock Text="Try another software or controller name." Style="{StaticResource QuietText}" TextAlignment="Center" />
        <Button Content="Clear search" HorizontalAlignment="Center" Click="ClearSearch_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</ContentDialog>
