<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Company>YUCP Studio</Company>
    <Product>VRCoplay</Product>
    <RepositoryUrl>https://github.com/Yeusepe/vrcoplay</RepositoryUrl>
    <Copyright>Copyright (c) 2026 YUCP Studio and contributors.</Copyright>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <GenerateRepositoryUrlAttribute>false</GenerateRepositoryUrlAttribute>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))=/_</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Releases/index.template.html" LogicalName="VRCoplay.ReleasePage.html" />
  </ItemGroup>
</Project>
